<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.quanlytoanhanhom4.controller.ResidentAddMoneyController"
      prefWidth="400" prefHeight="300">

    <!-- Top Bar -->
    <HBox spacing="10" style="-fx-background-color: #2874A6; -fx-padding: 12;">
        <children>
            <Label text="Nạp tiền vào tài khoản"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </children>
    </HBox>

    <!-- Balance Label nổi bật -->
    <HBox style="-fx-padding: 12; -fx-alignment: CENTER;">
        <children>
            <Label fx:id="balanceLabel" text="Số dư: 0.00 VNĐ"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2874A6;
                          -fx-background-color: #D6EAF8; -fx-background-radius: 8; -fx-padding: 10 20 10 20;"/>
        </children>
    </HBox>

    <!-- Center: Nhập số tiền -->
    <VBox spacing="15" style="-fx-padding: 20;">
        <children>
            <Label text="Số tiền muốn nạp (VNĐ):" style="-fx-font-size: 14px;"/>
            <TextField fx:id="amountField" promptText="Nhập số tiền"/>
            <Button fx:id="submitButton" text="Gửi" style="-fx-background-color: #27AE60; -fx-text-fill: white;"
                    onAction="#handleAddMoney"/>
        </children>
    </VBox>

</VBox>
