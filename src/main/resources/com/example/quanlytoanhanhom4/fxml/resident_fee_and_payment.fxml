<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.quanlytoanhanhom4.controller.ResidentFeeController"

            prefWidth="800" prefHeight="600">

    <!-- Top Bar -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #2874A6; -fx-padding: 12;">
            <children>
                <Label text="Quản lý Hóa đơn &amp; Thanh toán"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="balanceLabel" text="Số dư: 0.00 VNĐ"
                       style="-fx-font-size: 14px; -fx-text-fill: white;"/>
            </children>
        </HBox>
    </top>

    <!-- Center: List of invoices -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-padding: 10;">
            <content>
                <VBox fx:id="invoiceContainer" spacing="15" style="-fx-padding: 10;">
                    <!-- Hóa đơn sẽ được thêm bằng Controller -->
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
