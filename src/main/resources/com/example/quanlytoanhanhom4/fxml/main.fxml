<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.quanlytoanhanhom4.controller.MainController">
    <fx:define>
        <com.example.quanlytoanhanhom4.controller.ResidentFeeController fx:id="__badgeLoader__" />
    </fx:define>
   <top>
      <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2874A6; -fx-padding: 18;" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="6.0">
               <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="PHẦN MỀM QUẢN LÝ TOÀ NHÀ" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT" spacing="6.0">
               <Label fx:id="adminLabel" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="CHÀO ADMIN" />
               <Label style="-fx-text-fill: #E8F6FF; -fx-font-size: 12px;" text="Sẵn sàng hỗ trợ bạn 24/7" />
            </VBox>
            <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;" text="Đăng xuất" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox alignment="TOP_LEFT" spacing="12.0" style="-fx-background-color: #1E2735; -fx-padding: 24;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-text-fill: #9FB3C8; -fx-font-size: 12px; -fx-font-weight: bold;" text="DANH MỤC CHÍNH" />
             <Label style="-fx-text-fill: #9FB3C8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"
                    text="QUẢN LÝ CƯ DÂN &amp; CĂN HỘ"/>
             <Button mnemonicParsing="false" onAction="#handleResident" prefHeight="40.0" prefWidth="180.0"
                     style="-fx-background-color: #334055; -fx-text-fill: white; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 18; -fx-background-radius: 10;"
                     text="Quản lý cư dân"/>
             <Button mnemonicParsing="false" onAction="#handleResidentCard" prefHeight="40.0" prefWidth="180.0"
                     style="-fx-background-color: #334055; -fx-text-fill: white; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 18; -fx-background-radius: 10;"
                     text="Cấp lại thẻ dân cư"/>
             <Label style="-fx-text-fill: #9FB3C8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"
                    text="TÀI CHÍNH &amp; DỊCH VỤ"/>
             <Button mnemonicParsing="false" onAction="#handleAddMoney" prefHeight="40.0" prefWidth="180.0"
                     style="-fx-background-color: #334055; -fx-text-fill: white; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 18; -fx-background-radius: 10;"
                     text="Nạp tiền"/>
             <Button fx:id="residentFeeBtn" mnemonicParsing="false" onAction="#handleResidentFee" prefHeight="40.0" prefWidth="180.0"
                     style="-fx-background-color: #334055; -fx-text-fill: white; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 0 12 0 12; -fx-background-radius: 10;"
                     text="">
                 <graphic>
                     <HBox alignment="CENTER_LEFT" spacing="8" prefWidth="156">
                         <children>
                             <Label text="Thanh toán hóa đơn" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                             <Region HBox.hgrow="ALWAYS"/>
                             <Label fx:id="residentFeePendingLabel" text="0" visible="false"
                                    style="-fx-background-color: #C0392B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 999; -fx-padding: 0 6; -fx-min-width: 22; -fx-min-height: 22; -fx-alignment: CENTER;"/>
                         </children>
                     </HBox>
                 </graphic>
             </Button>




             <Label style="-fx-text-fill: #9FB3C8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"
                    text="THÔNG BÁO &amp; SỬA CHỮA"/>
             <Button mnemonicParsing="false" onAction="#handleNotification" prefHeight="40.0" prefWidth="180.0"
                     style="-fx-background-color: #334055; -fx-text-fill: white; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 18; -fx-background-radius: 10;"
                     text="Gửi thông báo"/>
             <Button mnemonicParsing="false" onAction="#handleRepairRequest" prefHeight="40.0" prefWidth="180.0"
                     style="-fx-background-color: #334055; -fx-text-fill: white; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 18; -fx-background-radius: 10;"
                     text="Yêu cầu sửa chữa"/>
         </children>
      </VBox>
   </left>
    <center>
        <VBox fx:id="centerContainer" alignment="TOP_CENTER" spacing="15.0"
              style="-fx-padding: 20; -fx-background-color: #f9f9f9; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-background-radius: 10;">

            <!-- Thông tin cư dân -->
            <Label fx:id="residentGreeting"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2a2a2a;
                      -fx-background-color: #e0e0e0; -fx-padding: 15; -fx-border-color: #b0b0b0;
                      -fx-border-radius: 10; -fx-background-radius: 10; -fx-alignment: center;"
                   maxWidth="400"
                   wrapText="true"/>

            <!-- Thông báo owner/non-owner -->
            <Label fx:id="residentStatus"
                   style="-fx-font-size: 14px; -fx-text-fill: #555555; -fx-wrap-text: true; -fx-text-alignment: center;"/>

            <Label text="Danh sách thành viên trong căn hộ của bạn:"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 0 5 0; -fx-alignment: center;"
                   alignment="CENTER"
            />
            <!-- Danh sách thành viên căn hộ -->
            <VBox fx:id="residentList" spacing="5.0" alignment="TOP_CENTER"></VBox>


        <!-- Cờ VN -->
            <ImageView fx:id="flagImage" fitHeight="100" fitWidth="120" pickOnBounds="true" preserveRatio="true">
                <VBox.margin>
                    <Insets top="100" right="0" bottom="0" left="0"/>
                </VBox.margin>
            </ImageView>
        </VBox>
    </center>




</BorderPane>