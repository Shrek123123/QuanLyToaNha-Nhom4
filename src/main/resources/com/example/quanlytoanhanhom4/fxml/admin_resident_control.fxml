<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.quanlytoanhanhom4.controller.ResidentController"
            style="-fx-background-color: #f0f2f5;">
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: linear-gradient(to right, #2874A6, #3498DB); -fx-padding: 20;">
            <children>
                <Label text="Quản lý Cư dân" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox spacing="5" alignment="CENTER_RIGHT">
                    <Label text="Lọc theo trạng thái:" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                    <ComboBox fx:id="filterStatusCombo" prefWidth="180" style="-fx-font-size: 14px;"
                              onAction="#handleFilter"/>
                </VBox>
                <Button text="← Quay lại" onAction="#handleBack"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-font-size: 14px;"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Danh sách cư dân"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statusLabel" style="-fx-text-fill: #27ae60; -fx-font-size: 14px;"/>
                </HBox>
                <TableView fx:id="residentTable" prefHeight="400"
                           style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                    <columns>
                        <TableColumn fx:id="colFullName" text="Họ tên" prefWidth="180">
                            <style>-fx-alignment: CENTER_LEFT;</style>
                        </TableColumn>

                        <TableColumn fx:id="colGender" text="Giới tính" prefWidth="90">
                            <style>-fx-alignment: CENTER;</style>
                        </TableColumn>

                        <TableColumn fx:id="colApartment" text="Số căn hộ" prefWidth="100">
                            <style>-fx-alignment: CENTER;</style>
                        </TableColumn>

                        <TableColumn fx:id="colOwner" text="Chủ căn hộ" prefWidth="140">
                            <style>-fx-alignment: CENTER;</style>
                        </TableColumn>

                        <TableColumn fx:id="colPhone" text="Số điện thoại" prefWidth="140">
                            <style>-fx-alignment: CENTER;</style>
                        </TableColumn>

                        <TableColumn fx:id="colEmail" text="Email" prefWidth="220">
                            <style>-fx-alignment: CENTER_LEFT;</style>
                        </TableColumn>

                        <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120">
                            <style>-fx-alignment: CENTER;</style>
                        </TableColumn>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
    <right>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="15"
                  style="-fx-padding: 20; -fx-min-width: 350; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, -2);">
                <children>
                    <Label text="📝 Thông tin cư dân"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 10 0;"/>

                    <Separator/>

                    <VBox spacing="8">
                        <Label text="Họ tên *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <TextField fx:id="fullNameField" prefWidth="300" promptText="Nhập họ tên"
                                   style="-fx-font-size: 14px;"/>
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Số điện thoại *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <TextField fx:id="phoneField" prefWidth="145" promptText="10-11 số"
                                       style="-fx-font-size: 14px;"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <TextField fx:id="emailField" prefWidth="145" promptText="email@example.com"
                                       style="-fx-font-size: 14px;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="CMND/CCCD" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <TextField fx:id="identityCardField" prefWidth="145" promptText="9-12 chữ số"
                                       style="-fx-font-size: 14px;"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Ngày sinh" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <DatePicker fx:id="dateOfBirthPicker" prefWidth="145" style="-fx-font-size: 14px;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Giới tính" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <ComboBox fx:id="genderCombo" prefWidth="145" style="-fx-font-size: 14px;"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Trạng thái" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <ComboBox fx:id="statusCombo" prefWidth="145" style="-fx-font-size: 14px;"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Số căn hộ *" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <TextField fx:id="apartmentField" prefWidth="145"
                                       promptText="VD: A101"
                                       style="-fx-font-size: 14px;"/>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Chủ căn hộ" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <ComboBox fx:id="ownerCombo" prefWidth="145"
                                      style="-fx-font-size: 14px;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="8">
                        <Label text="Địa chỉ" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <TextArea fx:id="addressArea" prefWidth="300" prefHeight="70" promptText="Nhập địa chỉ"
                                  style="-fx-font-size: 14px;"/>
                    </VBox>

                    <Separator/>

                    <Label text="📞 Liên hệ khẩn cấp"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <HBox spacing="10">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Họ tên" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <TextField fx:id="emergencyContactField" prefWidth="145" promptText="Tên người liên hệ"
                                       style="-fx-font-size: 14px;"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Số điện thoại" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                            <TextField fx:id="emergencyPhoneField" prefWidth="145" promptText="10-11 số"
                                       style="-fx-font-size: 14px;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="8">
                        <Label text="Ghi chú" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <TextArea fx:id="notesArea" prefWidth="300" prefHeight="80" promptText="Nhập ghi chú (nếu có)"
                                  style="-fx-font-size: 14px;"/>
                    </VBox>

                    <Separator/>

                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="addButton" text="➕ Thêm mới" onAction="#handleAdd"
                                style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 140; -fx-pref-height: 40; -fx-background-radius: 5; -fx-font-size: 14px;"/>
                        <Button fx:id="updateButton" text="✏️ Cập nhật" onAction="#handleUpdate" disable="true"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 140; -fx-pref-height: 40; -fx-background-radius: 5; -fx-font-size: 14px;"/>
                    </HBox>
                    <Button fx:id="deleteButton" text="🗑️ Xóa" onAction="#handleDelete" disable="true"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 300; -fx-pref-height: 40; -fx-background-radius: 5; -fx-font-size: 14px;"/>
                </children>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
